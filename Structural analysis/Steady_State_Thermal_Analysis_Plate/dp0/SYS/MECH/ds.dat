d,_CM33,temp,26.85
esel,s,type,,2
nsle
sf,all,hflux,625000.000000047
nsel,all
esel,all
/nopr
/gopr
autots,on
nsub,1,10,1
time,1.
outres,erase
outres,all,none
outres,nsol,all
outres,rsol,all
outres,eangl,all
outres,veng,all
outres,fflux,all,
outres,cont,all,
cnvtol,heat,,1.e-003,,1.e-006 ! Program Controlled. Set MINREF equivalent of 1e-6 Watts
